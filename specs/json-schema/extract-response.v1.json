{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duon.ai/schemas/extract-response.v1.json",
  "title": "ExtractResponse",
  "description": "Envelope response for document semantic extraction, isolating caller data from system evidence and metadata.",
  "type": "object",
  "required": [
    "data",
    "evidence",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "object",
      "description": "Strictly adheres to the caller-supplied Schema, or generic-output.v1.json if none provided. Contains zero evidence/meta pollution."
    },
    "evidence": {
      "type": "object",
      "description": "Map from JSON Pointer (RFC 6901, e.g. /party_a or /items/0/amount) to list of supporting evidence locations.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/EvidenceItem"
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "is_valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "message"],
            "properties": {
              "path": { "type": "string" },
              "message": { "type": "string" },
              "code": { "type": "string" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "document_sha256",
        "pipeline_version",
        "result_hash",
        "model"
      ],
      "properties": {
        "document_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pipeline_version": {
          "type": "string"
        },
        "result_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of the canonicalized response data and evidence."
        },
        "model": {
          "type": "string"
        },
        "execution_time_ms": {
          "type": "integer"
        }
      }
    }
  },
  "$defs": {
    "EvidenceItem": {
      "type": "object",
      "required": ["page", "item_ids", "quote", "bbox"],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "description": "1-indexed page number."
        },
        "item_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of the Document IR TextItem(s) forming this citation."
        },
        "bbox": {
          "type": "array",
          "description": "Bounding box: [x0, y0, x1, y1] with top-left origin.",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "quote": {
          "type": "string",
          "description": "Exact excerpt from the source document."
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    }
  }
}
